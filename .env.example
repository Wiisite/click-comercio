# Porta da API (em produção serve também o front-end)
PORT=3001
# Caminho do arquivo SQLite
DATABASE_PATH=./data/click.db
# Segredo para assinar o token de sessão (gere uma string longa e aleatória)
AUTH_SECRET=troque-este-segredo
# Conta admin criada automaticamente na primeira inicialização (se ainda não existir)
ADMIN_EMAIL=
ADMIN_SENHA=
